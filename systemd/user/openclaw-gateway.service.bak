[Unit]
Description=OpenClaw Gateway (v2026.5.28)
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
ExecStart=/usr/bin/node /home/ypathan/.local/share/fnm/node-versions/v24.16.0/installation/lib/node_modules/openclaw/dist/index.js gateway --port 18789
Restart=always
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=30
TimeoutStartSec=30
SuccessExitStatus=0 143
KillMode=control-group
Environment=HOME=/home/ypathan
Environment=TMPDIR=/tmp
Environment=PATH=/usr/bin:/run/user/1000/fnm_multishells/34462_1780470985815/bin:/home/ypathan/.local/share/fnm/node-versions/v24.16.0/installation/bin:/home/ypathan/.local/share/fnm/aliases/default/bin:/home/ypathan/.local/share/fnm/current/bin:/home/ypathan/.local/bin:/home/ypathan/.npm-global/bin:/home/ypathan/bin:/home/ypathan/.nix-profile/bin:/usr/local/bin:/bin
Environment=OPENCLAW_GATEWAY_PORT=18789
Environment=OPENCLAW_SYSTEMD_UNIT=openclaw-gateway.service
Environment="OPENCLAW_WINDOWS_TASK_NAME=OpenClaw Gateway"
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway
Environment=OPENCLAW_SERVICE_VERSION=2026.5.28

[Install]
WantedBy=default.target
