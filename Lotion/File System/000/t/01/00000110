eived] -> Family: ${frame.event}`);\n\t\t\t\t\tconsole.log(JSON.stringify(frame.payload, null, 2));\n\t\t\t\t}\n\t\t\t\tbreak;\n\n\t\t\tcase 'hello-ok':\n\t\t\t\t// Handshake succeeded! \n\t\t\t\tconsole.log('Handshake successful! Logged into OpenClaw.');\n\t\t\t\tconsole.log('Server features:', frame.features);\n\t\t\t\tonAuthenticated();\n\t\t\t\tbreak;\n\n\t\t\tcase 'res':\n\t\t\t\t// Handle standard request responses\n\t\t\t\tif (pendingRequests.has(frame.id)) {\n\t\t\t\t\tconst { resolve, reject } = pendingRequests.get(frame.id);\n\t\t\t\t\tpendingRequests.delete(frame.id);\n\t\t\t\t\tif (frame.ok) resolve(frame.payload);\n\t\t\t\t\telse reject(frame.error);\n\t\t\t\t}\n\t\t\t\tbreak;\n\n\t\t\tdefault:\n\t\t\t\tconsole.log('Received frame:', frame);\n\t\t}\n\t} catch (err) {\n\t\tconsole.error('Failed to parse incoming frame:', err.message);\n\t}\n});\n\nws.on('close', (code, reason) => {\n\tconsole.log(`Connection closed. Code: ${code}, Reason: ${reason.toString() || 'None'}`);\n});\n\nws.on('error', (error) => {\n\tconsole.error('WebSocket Error:', error);\n});\n\n/**\n * 2. Solve the Challenge Frame\n * Generates an HMAC signature using the token as the secret key \n * over the concatenation of nonce and timestamp.\n */\nfunction handleChallenge(payload) {\n\tconst { nonce, ts } = payload;\n\n\t// Create the message payload to verify (standard openclaw sequence: nonce + timestamp)\n\tconst message = `${nonce}:${ts}`;\n\n\t// Compute HMAC-SHA256 signature\n\tconst signature = crypto\n\t\t.createHmac('sha256', AUTH_TOKEN)\n\t\t.update(message)\n\t\t.digest('hex');\n\n\t// Send response verification frame back to the server\n\tconst verifyFrame = {\n\t\ttype: 'connect.verify', // Note: Check your specific gateway version if it expects a type: \"req\" or \"connect.verify\"\n\t\tparams: {\n\t\t\tsignature: signature\n\t\t}\n\t};\n\n\tws.send(JSON.stringify(verifyFrame));\n\tconsole.log('Sent verification signature back to gateway.');\n}\n\n// Helper to send standard requests\nfunction sendRequest(method, params = {}) {\n\treturn new Promise((resolve, reject) => {\n\t\tconst id = `req_${++requestIdCounter}`;\n\t\tconst requestFrame = { type: 'req', id, method, params };\n\t\tpendingRequests.set(id, { resolve, reject });\n\t\tws.send(JSON.stringify(requestFrame));\n\t});\n}\n\n// 3. Post-authentication logic\nasync function onAuthenticated() {\n\ttry {\n\t\tconsole.log('\\nFetching allowed runtime model catalog...');\n\t\tconst modelCatalog = await sendRequest('models.list', { view: 'configured' });\n\t\tconsole.log('--- Configured Models ---');\n\t\tconsole.log(JSON.stringify(modelCatalog, null, 2));\n\t} catch (error) {\n\t\tconsole.error('Request failed:', error);\n\t}\n}\n"]],"language":[["PowerShell"]]},"crdt_data":{"title":{"r":"8fCfdO_4mkg2d0tfEI4e9Q,\"start\",\"end\"","n":{"8fCfdO_4mkg2d0tfEI4e9Q,\"start\",\"end\"":{"s":{"x":"8fCfdO_4mkg2d0tfEI4e9Q","i":[{"t":"s"},{"t":"t","i":["4imwgqDJoDcG",1],"o":"start","l":3609,"c":"import WebSocket from 'ws';\nimport crypto from 'crypto'; // Needed to solve the cryptographic challenge\n\n// Configuration\nconst GATEWAY_URL = 'ws://89.117.55.23:18789';\nconst AUTH_TOKEN = 'nokian876';\n\n// Establish connection to the Gateway WebSocket server\nconst ws = new WebSocket(GATEWAY_URL);\n\n// Tracking pending requests to resolve their responses asynchronously\nconst pendingRequests = new Map();\nlet requestIdCounter = 0;\n\nws.on('open', () => {\n\tconsole.log('Connected to OpenClaw Gateway server. Initiating handshake...');\n\n\t// 1. Initial connection request (announcing ourselves)\n\tconst handshakeFrame = {\n\t\ttype: 'connect',\n\t\tparams: {\n\t\t\trole: 'operator'\n\t\t}\n\t};\n\n\tws.send(JSON.stringify(handshakeFrame));\n});\n\nws.on('message', (data) => {\n\ttry {\n\t\tconst frame = JSON.parse(data.toString());\n\n\t\t// Handle OpenClaw frame types\n\t\tswitch (frame.type) {\n\n\t\t\tcase 'event':\n\t\t\t\t// Handle server-pushed events\n\t\t\t\tif (frame.event === 'connect.challenge') {\n\t\t\t\t\tconsole.log('[Challenge Received] Solving cryptographic puzzle...');\n\t\t\t\t\thandleChallenge(frame.payload);\n\t\t\t\t} else {\n\t\t\t\t\tconsole.log(`[Event Received] -> Family: ${frame.event}`);\n\t\t\t\t\tconsole.log(JSON.stringify(frame.payload, null, 2));\n\t\t\t\t}\n\t\t\t\tbreak;\n\n\t\t\tcase 'hello-ok':\n\t\t\t\t// Handshake succeeded! \n\t\t\t\tconsole.log('Handshake successful! Logged into OpenClaw.');\n\t\t\t\tconsole.log('Server features:', frame.features);\n\t\t\t\tonAuthenticated();\n\t\t\t\tbreak;\n\n\t\t\tcase 'res':\n\t\t\t\t// Handle standard request responses\n\t\t\t\tif (pendingRequests.has(frame.id)) {\n\t\t\t\t\tconst { resolve, reject } = pendingRequests.get(frame.id);\n\t\t\t\t\tpendingRequests.delete(frame.id);\n\t\t\t\t\tif (frame.ok) resolve(frame.payload);\n\t\t\t\t\telse reject(frame.error);\n\t\t\t\t}\n\t\t\t\tbreak;\n\n\t\t\tdefault:\n\t\t\t\tconsole.log('Received frame:', frame);\n\t\t}\n\t} catch (err) {\n\t\tconsole.error('Failed to parse incoming frame:', err.message);\n\t}\n});\n\nws.on('close', (code, reason) => {\n\tconsole.log(`Connection closed. Code: ${code}, Reason: ${reason.toString() || 'None'}`);\n});\n\nws.on('error', (error) => {\n\tconsole.error('WebSocket Error:', error);\n});\n\n/**\n * 2. Solve the Challenge Frame\n * Generates an HMAC signature using the token as the secret key \n * over the concatenation of nonce and timestamp.\n */\nfunction handleChallenge(payload) {\n\tconst { nonce, ts } = payload;\n\n\t// Create the message payload to verify (standard openclaw sequence: nonce + timestamp)\n\tconst message = `${nonce}:${ts}`;\n\n\t// Compute HMAC-SHA256 signature\n\tconst signature = crypto\n\t\t.createHmac('sha256', AUTH_TOKEN)\n\t\t.update(message)\n\t\t.digest('hex');\n\n\t// Send response verification frame back to the server\n\tconst verifyFrame = {\n\t\ttype: 'connect.verify', // Note: Check your specific gateway version if it expects a type: \"req\" or \"connect.verify\"\n\t\tparams: {\n\t\t\tsignature: signature\n\t\t}\n\t};\n\n\tws.send(JSON.stringify(verifyFrame));\n\tconsole.log('Sent verification signature back to gateway.');\n}\n\n// Helper to send standard requests\nfunction sendRequest(method, params = {}) {\n\treturn new Promise((resolve, reject) => {\n\t\tconst id = `req_${++requestIdCounter}`;\n\t\tconst requestFrame = { type: 'req', id, method, params };\n\t\tpendingRequests.set(id, { resolve, reject });\n\t\tws.send(JSON.stringify(requestFrame));\n\t});\n}\n\n// 3. Post-authentication logic\nasync function onAuthenticated() {\n\ttry {\n\t\tconsole.log('\\nFetching allowed runtime model catalog...');\n\t\tconst modelCatalog = await sendRequest('models.list', { view: 'configured' });\n\t\tconsole.log('--- Configured Models ---');\n\t\tconsole.log(JSON.stringify(modelCatalog, null, 2));\n\t} catch (error) {\n\t\tconsole.error('Request failed:', error);\n\t}\n}\n"},{"t":"e"}],"l":""},"c":[]}}}},"crdt_format_version":1,"created_time":1780306228592,"last_edited_time":1780306229129,"parent_id":"3727e452-d36b-8052-a8fd-d41d44e4e4f1","parent_table":"block","alive":true,"format":{"code_wrap":true},"created_by_table":"notion_user","created_by_id":"d67e8d1d-b0b9-4e54-ae02-e6e873d06a68","last_edited_by_table":"notion_user","last_edited_by_id":"d67e8d1d-b0b9-4e54-ae02-e6e873d06a68"},"role":"editor"}},"3727e452-d36b-809b-a4b3-f056acfadacc":{"spaceId":"f756c599-316b-47b6-9328-00ed5120b2e6","value":{"value":{"id":"3727e452-d36b-809b-a4b3-f056acfadacc","space_id":"f756c599-316b-47b6-9328-00ed5120b2e6","version":3,"type":"text","crdt_data":{"title":{"r":"-obOsSYytl8Yh_vb2d44ow,\"start\",\"end\"","n":{"-obOsSYytl8Yh_vb2d44ow,\"start\",\"end\"":{"s":{"x":"-obOsSYytl8Yh_vb2d44ow","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}},"crdt_format_version":1,"created_time":1780306771024,"last_edited_time":1780306771028,"parent_id":"3727e452-d36b-8052-a8fd-d41d44e4e4f1","parent_table":"block","alive":true,"created_by_table":"notion_user","created_by_id":"