modify_font cell_height 1px

font_size 14.0
#hide_window_decorations yes

cursor_blink_interval 0


#----------tabs-----------
tab_bar_style powerline
tab_powerline_style round
tab_title_template "{index}"


# -------background settings------
background_opacity 0.9
background_blur 90

map super+left send_text all \x01
map super+right send_text all \x05
map super+backspace send_text all \x15
map ctrl+t new_tab
map ctrl+c copy_to_clipboard
map ctrl+v paste_from_clipboard
map ctrl+shift+c send_text all \x03
#------------------------------

linux_display_server wayland

# BEGIN_KITTY_THEME
# Catppuccin-Mocha
include current-theme.conf
# END_KITTY_THEME
#
enable_audio_bell no


# BEGIN_KITTY_FONTS
font_family      family='JetBrainsMono Nerd Font' postscript_name=JetBrainsMonoNF-Medium
bold_font        family='JetBrainsMono Nerd Font' postscript_name=JetBrainsMonoNF-Medium
italic_font      family='JetBrainsMono Nerd Font' postscript_name=JetBrainsMonoNF-Medium
bold_italic_font family='JetBrainsMono Nerd Font' postscript_name=JetBrainsMonoNF-Medium
# END_KITTY_FONTS
